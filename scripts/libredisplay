#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
import urllib.parse
import zipfile
from pathlib import Path, PurePosixPath

REPOSITORY = "Gubna-Tech/LibreDisplay"
API_URL = f"https://api.github.com/repos/{REPOSITORY}/releases/latest"
MAX_ARCHIVE_BYTES = 300 * 1024 * 1024
MAX_MEMBER_BYTES = 150 * 1024 * 1024
MAX_TOTAL_UNPACKED_BYTES = 700 * 1024 * 1024


def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def install_dir():
    return Path.home() / "libredisplay"


def current_version():
    path = install_dir() / "VERSION"
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError:
        fail(f"LibreDisplay does not appear to be installed at {install_dir()}.\nRun install.sh for the first installation.")
    if not re.fullmatch(r"\d+\.\d+\.\d+", value):
        fail("The installed LibreDisplay VERSION file is invalid.")
    return value


def data_dir():
    return install_dir() / "data"


def _env_file_values():
    values = {}
    path = data_dir() / "libredisplay.env"
    try:
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip().strip('"').strip("'")
            if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
                values[key] = value
    except OSError:
        pass
    return values


def runtime_port():
    raw = os.environ.get("DASHBOARD_PORT") or _env_file_values().get("DASHBOARD_PORT") or "8787"
    try:
        port = int(raw)
    except (TypeError, ValueError):
        port = 8787
    return port if 1 <= port <= 65535 else 8787


def local_api_url(path):
    path = "/" + str(path or "").lstrip("/")
    return f"http://127.0.0.1:{runtime_port()}{path}"


def api_json(path, method="GET", payload=None, timeout=8):
    data = None
    headers = {"User-Agent": f"LibreDisplay/{current_version()} CLI"}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(local_api_url(path), data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read().decode("utf-8", "replace")
            return int(response.status), json.loads(body or "{}")
    except urllib.error.HTTPError as exc:
        try:
            body = json.loads(exc.read().decode("utf-8", "replace") or "{}")
        except Exception:
            body = {"error": f"HTTP {exc.code}"}
        return int(exc.code), body
    except (OSError, urllib.error.URLError, TimeoutError) as exc:
        raise RuntimeError(f"LibreDisplay server is not reachable at {local_api_url('/healthz')}: {exc}") from exc


def _print_urls(title, values):
    rows = [str(x).strip() for x in (values or []) if str(x).strip()]
    if not rows:
        return
    print(title)
    for value in rows:
        print(f"  {value}")


def print_status():
    print(f"LibreDisplay v{current_version()}")
    try:
        status, health = api_json("/api/system-health")
    except RuntimeError as exc:
        print("Server: offline / unreachable")
        print(f"  {exc}")
        return 1
    if status != 200 or not health.get("ok"):
        print(f"Server: unhealthy (HTTP {status})")
        return 1
    mode = health.get("serverMode") or {}
    print(f"Server: online · {local_api_url('/dashboard.html?endpoint=main')}")
    if mode.get("supported"):
        print("Host mode: " + ("server only" if mode.get("effectiveServerOnly") else "display + server"))
    else:
        print("Host mode: server deployment (no native kiosk manager)")
    hardware = health.get("hardware") or {}
    if hardware.get("model"):
        print(f"Hardware: {hardware.get('model')}")
    kiosk = health.get("kioskHeartbeat") or {}
    if mode.get("effectiveServerOnly"):
        print("Local kiosk: intentionally disabled")
    elif kiosk.get("present"):
        print(f"Local kiosk: online{(' · '+str(kiosk.get('viewport'))) if kiosk.get('viewport') else ''}")
    else:
        print("Local kiosk: no heartbeat")
    try:
        _, remote = api_json("/api/remote-info")
        print("Remote Access: " + ("enabled" if remote.get("remoteEnabled") else "disabled"))
    except RuntimeError:
        pass
    return 0


def print_addresses(include_display_links=False):
    status, info = api_json("/api/remote-info")
    if status != 200 or not info.get("ok"):
        fail(info.get("error") or f"Could not read LibreDisplay addresses (HTTP {status}).")
    print(f"LibreDisplay host: {info.get('hostname') or 'unknown'} · port {info.get('port') or runtime_port()}")
    if not info.get("remoteEnabled"):
        print("Remote Access is disabled.")
        print("Enable it in Settings, or run: libredisplay remote on")
        return 2
    _print_urls("Owner-device connection addresses:", info.get("connectUrls"))
    _print_urls("Owner/account login addresses:", info.get("reconnectUrls"))
    if include_display_links:
        _print_urls("Read-only Display Links (treat these as credentials):", info.get("displayUrls"))
    else:
        print("Read-only Display Links are hidden by default. Use --include-display-links to print them.")
    return 0


def create_connect_code(enable_remote=False, show_direct=False, as_json=False):
    status, info = api_json("/api/remote-info")
    if status != 200 or not info.get("ok"):
        fail(info.get("error") or f"Could not inspect Remote Access (HTTP {status}).")
    if not info.get("remoteEnabled"):
        if not enable_remote:
            fail("Remote Access is disabled. Run `libredisplay remote on`, or rerun with `libredisplay connect --enable-remote`.", 2)
        status, changed = api_json("/api/remote-access", method="POST", payload={"enabled": True})
        if status != 200 or not changed.get("ok"):
            fail(changed.get("error") or f"Could not enable Remote Access (HTTP {status}).")
    status, payload = api_json("/api/owner-enrollment", method="POST", payload={"action": "create"})
    if status != 200 or not payload.get("ok"):
        fail(payload.get("error") or f"Could not create an Owner connection code (HTTP {status}).")
    if as_json:
        safe = {k: payload.get(k) for k in ("code", "expiresAt", "ttlSeconds", "connectUrls", "primaryUrl")}
        if show_direct:
            safe["directUrl"] = payload.get("directUrl")
        print(json.dumps(safe, indent=2))
        return 0
    print("LibreDisplay Owner connection")
    print(f"Code: {payload.get('code') or ''}")
    ttl = int(payload.get("ttlSeconds") or 0)
    if ttl:
        print(f"Expires: about {max(1, round(ttl / 60))} minute(s) · single use")
    _print_urls("On the new device, open one of these addresses:", payload.get("connectUrls"))
    if show_direct and payload.get("directUrl"):
        print("Direct one-scan/link URL (contains the temporary code; treat it as a short-lived secret):")
        print(f"  {payload['directUrl']}")
    print("Then enter the code above and name the device.")
    return 0


def remote_access_command(action):
    action = str(action or "status").lower()
    if action == "status":
        status, info = api_json("/api/remote-info")
        if status != 200 or not info.get("ok"):
            fail(info.get("error") or f"Could not read Remote Access status (HTTP {status}).")
        print("Remote Access: " + ("enabled" if info.get("remoteEnabled") else "disabled"))
        if info.get("remoteEnabled"):
            _print_urls("Owner-device connection addresses:", info.get("connectUrls"))
        return 0
    enabled = action == "on"
    status, payload = api_json("/api/remote-access", method="POST", payload={"enabled": enabled})
    if status != 200 or not payload.get("ok"):
        fail(payload.get("error") or f"Could not change Remote Access (HTTP {status}).")
    print("Remote Access enabled." if enabled else "Remote Access disabled and active remote credentials were cleared.")
    return 0


def _server_mode_file():
    return data_dir() / "server-mode.json"


def _write_server_mode_fallback(enabled):
    path = _server_mode_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {"serverOnly": bool(enabled), "requestedAt": int(__import__('time').time())}
    fd, tmp_name = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(payload, fh, separators=(",", ":")); fh.write("\n")
        os.chmod(tmp_name, 0o600)
        os.replace(tmp_name, path)
    finally:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass


def server_only_command(action):
    action = str(action or "status").lower()
    if action == "status":
        try:
            status, payload = api_json("/api/server-mode")
            if status == 200 and payload.get("ok"):
                print("Server-only mode: " + ("on" if payload.get("effectiveServerOnly") else "off"))
                if payload.get("forcedByEnvironment"):
                    print("Mode is forced by DASHBOARD_NO_BROWSER in the host environment.")
                elif not payload.get("supported"):
                    print("This deployment does not use the native Pi kiosk manager.")
                return 0
        except RuntimeError:
            pass
        row = {}
        try:
            row = json.loads(_server_mode_file().read_text(encoding="utf-8"))
        except Exception:
            pass
        print("Server-only mode (saved request): " + ("on" if row.get("serverOnly") else "off"))
        print("Server is currently unreachable, so effective runtime state could not be confirmed.")
        return 1
    enabled = action in ("on", "enable")
    try:
        status, payload = api_json("/api/server-mode", method="POST", payload={"serverOnly": enabled})
        if status == 200 and payload.get("ok"):
            if payload.get("forcedByEnvironment"):
                print("Server-only mode is forced by DASHBOARD_NO_BROWSER in the host environment.")
                if enabled:
                    print("The local Chromium dashboard remains disabled; the LibreDisplay server stays online.")
                    return 0
                print("The saved preference was changed, but the local dashboard cannot start until DASHBOARD_NO_BROWSER is removed and LibreDisplay is restarted.")
                return 2
            if not payload.get("supported"):
                print("Saved the server-only preference, but this deployment does not use LibreDisplay's native Pi kiosk manager.")
                print("No local Chromium process is controlled by LibreDisplay on this host.")
                return 0
            effective = bool(payload.get("effectiveServerOnly"))
            print("Server-only mode enabled. The local Chromium dashboard will stop; the server stays online." if effective else "Server-only mode disabled. The local Chromium dashboard will start shortly.")
            return 0
        if status not in (0, 404):
            fail(payload.get("error") or f"Could not change server-only mode (HTTP {status}).")
    except RuntimeError:
        pass
    _write_server_mode_fallback(enabled)
    print("Saved server-only mode request directly because the LibreDisplay server is offline.")
    print("It will take effect the next time LibreDisplay starts.")
    return 0


def display_mode_command(mode):
    status, payload = api_json("/api/display-mode", method="POST", payload={"mode": mode})
    if status != 200 or not payload.get("ok"):
        fail(payload.get("error") or f"Could not change display mode (HTTP {status}).")
    print(f"Local display mode requested: {mode}")
    return 0


def doctor():
    checks = []
    root = install_dir()
    for rel in ("VERSION", "app/dashboard_server.py", "app/dashboard.html", "scripts/start.sh"):
        checks.append((f"file {rel}", (root / rel).is_file(), ""))
    checks.append(("data directory writable", data_dir().is_dir() and os.access(data_dir(), os.W_OK), str(data_dir())))
    try:
        with urllib.request.urlopen(local_api_url("/healthz"), timeout=4) as response:
            checks.append(("server healthz", response.status == 200, f"HTTP {response.status}"))
    except Exception as exc:
        checks.append(("server healthz", False, str(exc)))
    try:
        status, health = api_json("/api/system-health", timeout=6)
        checks.append(("system-health API", status == 200 and bool(health.get("ok")), f"HTTP {status}"))
        mode = health.get("serverMode") or {}
        if mode.get("supported"):
            checks.append(("host mode", True, "server only" if mode.get("effectiveServerOnly") else "display + server"))
        integrity = health.get("startupIntegrity") or {}
        checks.append(("startup integrity", bool(integrity.get("ok")), str(integrity.get("version") or "not verified")))
    except Exception as exc:
        checks.append(("system-health API", False, str(exc)))
    failed = 0
    for name, ok, detail in checks:
        failed += 0 if ok else 1
        print(f"{'PASS' if ok else 'FAIL'}  {name}{(' · '+detail) if detail else ''}")
    if failed:
        print(f"Doctor found {failed} issue(s). See HELP.md → Troubleshooting and recovery.")
        return 1
    print("LibreDisplay doctor: all checked items passed.")
    return 0


def run_backup_restore(command, extra):
    script = install_dir() / "scripts" / "server-backup.py"
    if not script.is_file():
        fail("LibreDisplay backup tooling is missing. Reinstall or update LibreDisplay.")
    return int(subprocess.run([sys.executable, str(script), command, *extra], check=False).returncode)


def show_logs(kind="browser", lines=120):
    names = {"browser": "chromium-stderr.log", "update": "update.log", "rollback": "rollback.log"}
    path = data_dir() / names[kind]
    if not path.is_file():
        print(f"No {kind} log is available yet: {path}")
        return 1
    rows = path.read_text(encoding="utf-8", errors="replace").splitlines()
    for row in rows[-max(1, int(lines)):]:
        print(row)
    return 0


def version_tuple(value):
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", str(value or "").strip())
    if not match:
        raise ValueError("Invalid release version")
    return tuple(int(part) for part in match.groups())


def github_request(url, timeout=20):
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"LibreDisplay/{current_version()} updater",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read()


def latest_release():
    try:
        payload = json.loads(github_request(API_URL, timeout=15).decode("utf-8"))
    except (OSError, urllib.error.URLError, urllib.error.HTTPError, TimeoutError, json.JSONDecodeError) as exc:
        fail(f"Could not check GitHub for LibreDisplay updates: {exc}")

    release_tag = str(payload.get("tag_name") or "").strip()
    try:
        parts = version_tuple(release_tag)
    except ValueError:
        fail("GitHub returned an invalid LibreDisplay release version.")
    latest = ".".join(str(part) for part in parts)

    alternate_tag = release_tag[1:] if release_tag.lower().startswith("v") else "v" + release_tag
    tag_url = f"https://github.com/{REPOSITORY}/archive/refs/tags/{urllib.parse.quote(release_tag, safe='')}.zip"
    alternate_url = f"https://github.com/{REPOSITORY}/archive/refs/tags/{urllib.parse.quote(alternate_tag, safe='')}.zip"

    preferred_names = (f"LibreDisplay-v{latest}.zip", f"LibreDisplay-{latest}.zip")
    asset = None
    for preferred_name in preferred_names:
        asset = next((row for row in (payload.get("assets") or []) if str(row.get("name") or "") == preferred_name and row.get("browser_download_url")), None)
        if asset is not None:
            break

    if asset is not None:
        digest = str(asset.get("digest") or "").strip().lower()
        if digest and not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
            digest = ""
        try:
            size = int(asset.get("size") or 0)
        except (TypeError, ValueError):
            size = 0
        return {
            "version": latest,
            "tag": release_tag,
            "url": str(asset["browser_download_url"]),
            "alternate_url": tag_url,
            "fallback_urls": [tag_url, alternate_url],
            "digest": digest,
            "size": max(0, size),
            "source": "release-asset",
        }

    return {
        "version": latest,
        "tag": release_tag,
        "url": tag_url,
        "alternate_url": alternate_url,
        "fallback_urls": [alternate_url],
        "digest": "",
        "size": 0,
        "source": "tag-archive",
    }


def print_check():
    installed = current_version()
    release = latest_release()
    newest = release["version"]
    if version_tuple(newest) > version_tuple(installed):
        print(f"Update available: LibreDisplay v{installed} -> v{newest}")
        print("Run: libredisplay update")
        return 10
    if version_tuple(newest) == version_tuple(installed):
        print(f"LibreDisplay v{installed} is up to date.")
        return 0
    print(f"Installed LibreDisplay v{installed} is newer than the latest published release v{newest}.")
    return 0


def download_release(release, destination):
    urls = [release["url"]]
    for fallback in release.get("fallback_urls") or []:
        if fallback and fallback not in urls:
            urls.append(fallback)
    if release.get("alternate_url") and release["alternate_url"] not in urls:
        urls.append(release["alternate_url"])

    last_exc = None
    for index, attempt_url in enumerate(urls):
        request = urllib.request.Request(attempt_url, headers={"User-Agent": f"LibreDisplay/{current_version()} updater"})
        hasher = hashlib.sha256()
        total = 0
        try:
            with urllib.request.urlopen(request, timeout=45) as response, destination.open("wb") as output:
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > MAX_ARCHIVE_BYTES:
                        fail("Downloaded release archive exceeded the safety size limit.")
                    hasher.update(chunk)
                    output.write(chunk)
        except (OSError, urllib.error.URLError, urllib.error.HTTPError, TimeoutError) as exc:
            last_exc = exc
            destination.unlink(missing_ok=True)
            continue

        # GitHub asset size/digest metadata belongs only to the preferred asset.
        # Tag-archive fallbacks are generated independently and cannot be compared
        # against the attached asset metadata.
        if index == 0:
            if release.get("size") and total != release["size"]:
                destination.unlink(missing_ok=True)
                fail("The downloaded release size does not match GitHub's asset metadata.")
            actual = hasher.hexdigest()
            expected = release.get("digest", "").split(":", 1)[1] if release.get("digest") else ""
            if expected and actual != expected:
                destination.unlink(missing_ok=True)
                fail("The downloaded release failed its SHA-256 verification.")
        return hasher.hexdigest()

    fail(f"Could not download the LibreDisplay release using the release asset or supported tag archives: {last_exc}")


def safe_extract(archive, destination):
    seen = set()
    total = 0
    try:
        with zipfile.ZipFile(archive) as bundle:
            for info in bundle.infolist():
                raw = info.filename.replace("\\", "/")
                path = PurePosixPath(raw)
                if not raw or raw.startswith("/") or ".." in path.parts:
                    fail("The release archive contains an unsafe path.")
                if raw in seen:
                    fail("The release archive contains duplicate entries.")
                seen.add(raw)
                mode = (info.external_attr >> 16) & 0xFFFF
                if stat.S_ISLNK(mode):
                    fail("The release archive contains a symbolic link.")
                if info.file_size > MAX_MEMBER_BYTES:
                    fail("The release archive contains an unexpectedly large file.")
                total += info.file_size
                if total > MAX_TOTAL_UNPACKED_BYTES:
                    fail("The release archive exceeds LibreDisplay's unpacked-size safety limit.")
            bundle.extractall(destination)
            # Python's zipfile extraction does not restore Unix execute bits.
            # Normalize trusted release entries so scripts remain runnable after
            # an in-app update, while never carrying special/world-writable bits.
            for info in bundle.infolist():
                raw = info.filename.replace("\\", "/")
                path = PurePosixPath(raw)
                target = destination.joinpath(*path.parts)
                if not target.exists():
                    continue
                source_mode = (info.external_attr >> 16) & 0o777
                if target.is_dir():
                    os.chmod(target, 0o755)
                elif target.is_file():
                    os.chmod(target, 0o755 if source_mode & 0o111 else 0o644)
    except zipfile.BadZipFile:
        fail("The downloaded release is not a valid ZIP archive.")


def update(no_reboot=False):
    installed = current_version()
    release = latest_release()
    newest = release["version"]
    if version_tuple(newest) <= version_tuple(installed):
        if newest == installed:
            print(f"LibreDisplay v{installed} is already up to date.")
        else:
            print(f"Installed LibreDisplay v{installed} is newer than the latest published release v{newest}; nothing was changed.")
        return 0

    print(f"LibreDisplay update available: v{installed} -> v{newest}")
    print("Downloading the official GitHub release...")
    with tempfile.TemporaryDirectory(prefix="libredisplay-update-") as temp_name:
        temp = Path(temp_name)
        archive = temp / f"LibreDisplay-v{newest}.zip"
        download_release(release, archive)
        release_dir = temp / "release"
        release_dir.mkdir()
        safe_extract(archive, release_dir)

        release_root = release_dir
        if not (release_root / "VERSION").is_file():
            children = [item for item in release_dir.iterdir() if item.is_dir()]
            if len(children) == 1 and (children[0] / "VERSION").is_file():
                release_root = children[0]

        version_path = release_root / "VERSION"
        updater = release_root / "update.sh"
        required = (
            version_path, updater,
            release_root / "app" / "dashboard.html",
            release_root / "app" / "dashboard_server.py",
            release_root / "app" / "js" / "app.js",
            release_root / "app" / "css" / "dashboard.css",
        )
        if any(not path.is_file() for path in required):
            fail("The downloaded release is missing required LibreDisplay files.")
        packaged_version = version_path.read_text(encoding="utf-8").strip()
        if packaged_version != newest:
            fail("The downloaded release VERSION does not match the GitHub release tag.")

        command = ["/bin/sh", str(updater)]
        if no_reboot:
            command.append("--no-reboot")
        result = subprocess.run(command, cwd=str(release_root), check=False)
        return int(result.returncode)


def run_field_check(duration_minutes=None, interval_seconds=None, once=False, release_gate=False, resume=False, label="", output=""):
    candidates = [
        install_dir() / "scripts" / "field-readiness.py",
        Path(__file__).resolve().with_name("field-readiness.py"),
    ]
    script = next((path for path in candidates if path.is_file()), None)
    if script is None:
        fail("LibreDisplay field-readiness tooling is missing. Reinstall or update LibreDisplay.")
    command = [sys.executable, str(script)]
    if once:
        command.append("--once")
    elif duration_minutes is not None:
        command.extend(["--duration-minutes", str(duration_minutes)])
    if release_gate:
        command.append("--release-gate")
    if resume:
        command.append("--resume")
    if interval_seconds is not None:
        command.extend(["--interval-seconds", str(interval_seconds)])
    if label:
        command.extend(["--label", label])
    if output:
        command.extend(["--output", output])
    return int(subprocess.run(command, check=False).returncode)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "-update":
        sys.argv[1] = "update"

    parser = argparse.ArgumentParser(
        prog="libredisplay",
        description="Manage a native LibreDisplay installation.",
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("status", help="Show server, host-mode, kiosk, and Remote Access status.")
    addr_parser = sub.add_parser("addresses", help="Show addresses used to reach this LibreDisplay over the LAN/VPN.")
    addr_parser.add_argument("--include-display-links", action="store_true", help="Also print read-only Display Links (these contain credentials).")
    connect_parser = sub.add_parser("connect", help="Create a short-lived one-time Owner-device connection code.")
    connect_parser.add_argument("--enable-remote", action="store_true", help="Enable Remote Access first if it is currently disabled.")
    connect_parser.add_argument("--show-direct", action="store_true", help="Print the direct temporary-code URL as well as the safer manual address + code.")
    connect_parser.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    remote_parser = sub.add_parser("remote", help="Show, enable, or disable trusted-network Remote Access.")
    remote_parser.add_argument("action", nargs="?", choices=("status", "on", "off"), default="status")
    server_parser = sub.add_parser("server-only", help="Show or change native Pi server-only mode.")
    server_parser.add_argument("action", nargs="?", choices=("status", "on", "off", "enable", "disable"), default="status")
    display_parser = sub.add_parser("display-mode", help="Switch the local native Pi browser between kiosk and windowed mode.")
    display_parser.add_argument("mode", choices=("kiosk", "windowed"))
    sub.add_parser("doctor", help="Run quick local installation, server, and startup-integrity checks.")
    logs_parser = sub.add_parser("logs", help="Show recent LibreDisplay browser/update/rollback logs.")
    logs_parser.add_argument("--type", choices=("browser", "update", "rollback"), default="browser")
    logs_parser.add_argument("--lines", type=int, default=120)
    backup_parser = sub.add_parser("backup", help="Create a sensitive .ldbackup archive using LibreDisplay backup tooling.")
    backup_parser.add_argument("archive", nargs="?", default="", help="Optional destination archive; defaults to ~/libredisplay-backups/.")
    backup_parser.add_argument("--include-host", action="store_true", help="Include LibreDisplay-managed host configuration (sudo may be required).")
    restore_parser = sub.add_parser("restore", help="Restore or verify a .ldbackup archive using LibreDisplay backup tooling.")
    restore_parser.add_argument("archive", help="Backup archive to restore or verify.")
    restore_parser.add_argument("--yes", "-y", action="store_true", help="Restore without an interactive confirmation.")
    restore_parser.add_argument("--verify-only", action="store_true", help="Verify the archive without changing files.")
    sub.add_parser("check", help="Check GitHub for a newer LibreDisplay release.")
    update_parser = sub.add_parser("update", help="Back up and update LibreDisplay to the newest GitHub release.")
    update_parser.add_argument("--no-reboot", action="store_true", help="Install the update without rebooting afterward.")
    field_parser = sub.add_parser("field-check", help="Collect a privacy-safe Pi/browser field-readiness soak report.")
    field_parser.add_argument("--duration-minutes", type=float, default=None, help="How long to sample. Default: 30 minutes, or 720 minutes with --release-gate.")
    field_parser.add_argument("--interval-seconds", type=float, default=None, help="Seconds between samples. Default: 15; --resume preserves the original interval.")
    field_parser.add_argument("--once", action="store_true", help="Collect one sample immediately.")
    field_parser.add_argument("--release-gate", action="store_true", help="Run the strict resumable 12-hour release field gate for the installed LibreDisplay version.")
    field_parser.add_argument("--resume", action="store_true", help="Resume a release/field soak after reboot, power loss, or interruption.")
    field_parser.add_argument("--label", default="", help="Optional label such as pi3-living-room or pi4-regression.")
    field_parser.add_argument("--output", default="", help="Optional JSON output path; Markdown is written beside it.")
    sub.add_parser("version", help="Show the installed LibreDisplay version.")
    args = parser.parse_args()

    if args.command in (None, "version"):
        print(f"LibreDisplay v{current_version()}")
        if args.command is None:
            print("Commands: status, addresses, connect, remote, server-only, display-mode, doctor, logs, backup, restore, check, update, field-check, version")
            print("Run `libredisplay --help` or `libredisplay <command> --help` for details.")
        return 0
    if args.command == "status":
        return print_status()
    if args.command == "addresses":
        return print_addresses(include_display_links=args.include_display_links)
    if args.command == "connect":
        return create_connect_code(enable_remote=args.enable_remote, show_direct=args.show_direct, as_json=args.json)
    if args.command == "remote":
        return remote_access_command(args.action)
    if args.command == "server-only":
        return server_only_command(args.action)
    if args.command == "display-mode":
        return display_mode_command(args.mode)
    if args.command == "doctor":
        return doctor()
    if args.command == "logs":
        return show_logs(args.type, args.lines)
    if args.command == "backup":
        extra = ([args.archive] if args.archive else []) + (["--include-host"] if args.include_host else [])
        return run_backup_restore("backup", extra)
    if args.command == "restore":
        extra = [args.archive] + (["--yes"] if args.yes else []) + (["--verify-only"] if args.verify_only else [])
        return run_backup_restore("restore", extra)
    if args.command == "check":
        return print_check()
    if args.command == "update":
        return update(no_reboot=args.no_reboot)
    if args.command == "field-check":
        return run_field_check(duration_minutes=args.duration_minutes, interval_seconds=args.interval_seconds, once=args.once, release_gate=args.release_gate, resume=args.resume, label=args.label, output=args.output)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
